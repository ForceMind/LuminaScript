#!/bin/bash

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
if [ -z "${SCRIPT_PATH:-}" ]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
GLOBAL_RUNTIME_FILE="/etc/miaobi/runtime.env"
SYSTEMD_BACKEND_SERVICE="lumina-backend"
SYSTEMD_FRONTEND_SERVICE="lumina-frontend"
SYSTEMD_WORKER_SERVICE="lumina-worker"
SYSTEMD_BACKEND_FILE="/etc/systemd/system/${SYSTEMD_BACKEND_SERVICE}.service"
SYSTEMD_FRONTEND_FILE="/etc/systemd/system/${SYSTEMD_FRONTEND_SERVICE}.service"
SYSTEMD_WORKER_FILE="/etc/systemd/system/${SYSTEMD_WORKER_SERVICE}.service"

is_project_dir() {
    local dir="$1"
    [ -n "$dir" ] || return 1
    [ -d "$dir" ] || return 1
    [ -d "$dir/backend" ] || return 1
    [ -d "$dir/frontend" ] || return 1
    [ -f "$dir/update.sh" ] || return 1
    [ -f "$dir/uninstall.sh" ] || return 1
    return 0
}

use_systemd_services() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return 1
    fi
    if [ -f "$SYSTEMD_BACKEND_FILE" ] && \
       [ -f "$SYSTEMD_WORKER_FILE" ] && \
       [ -f "$SYSTEMD_FRONTEND_FILE" ]; then
        return 0
    fi
    return 1
}

resolve_from_runtime_file() {
    local runtime_file="$1"
    local value=""
    [ -f "$runtime_file" ] || return 1
    value="$(sed -n 's/^PROJECT_DIR=//p' "$runtime_file" | head -n 1)"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    [ -n "$value" ] || return 1
    if is_project_dir "$value"; then
        cd "$value" && pwd
        return 0
    fi
    return 1
}

resolve_from_runtime_candidates() {
    local candidate resolved
    for candidate in \
        "${MIAOBI_RUNTIME_FILE:-}" \
        "$GLOBAL_RUNTIME_FILE" \
        "/usr/local/etc/miaobi/runtime.env" \
        "$SCRIPT_DIR/.lumina_runtime" \
        "$PWD/.lumina_runtime" \
        "${HOME:-}/LuminaScript/.lumina_runtime" \
        "/root/LuminaScript/.lumina_runtime" \
        "/opt/LuminaScript/.lumina_runtime" \
        "/srv/LuminaScript/.lumina_runtime"
    do
        [ -n "$candidate" ] || continue
        if resolved="$(resolve_from_runtime_file "$candidate")"; then
            echo "$resolved"
            return 0
        fi
    done
    return 1
}

scan_runtime_files() {
    local base candidate resolved
    for base in "${HOME:-}" "/root" "/home" "/opt" "/srv"; do
        [ -d "$base" ] || continue
        while IFS= read -r candidate; do
            [ -n "$candidate" ] || continue
            if resolved="$(resolve_from_runtime_file "$candidate")"; then
                echo "$resolved"
                return 0
            fi
        done < <(find "$base" -maxdepth 4 -type f -name ".lumina_runtime" 2>/dev/null | head -n 120)
    done
    return 1
}

detect_project_dir() {
    local candidate resolved

    if [ -n "${MIAOBI_PROJECT_DIR:-}" ] && is_project_dir "$MIAOBI_PROJECT_DIR"; then
        cd "$MIAOBI_PROJECT_DIR" && pwd
        return
    fi

    for candidate in "$SCRIPT_DIR" "$PWD" "$(dirname "$SCRIPT_PATH")" "/root/LuminaScript" "/opt/LuminaScript" "/srv/LuminaScript"; do
        if is_project_dir "$candidate"; then
            cd "$candidate" && pwd
            return
        fi
    done

    if resolved="$(resolve_from_runtime_candidates)"; then
        echo "$resolved"
        return
    fi

    if resolved="$(scan_runtime_files)"; then
        echo "$resolved"
        return
    fi

    echo ""
}

PROJECT_DIR="$(detect_project_dir)"
if ! is_project_dir "$PROJECT_DIR"; then
    echo -e "${RED}无法定位项目目录，miaobi 暂时无法执行此命令。${NC}" >&2
    echo -e "${YELLOW}请先指定项目目录，例如：MIAOBI_PROJECT_DIR=/your/LuminaScript miaobi update${NC}" >&2
    exit 1
fi

RUNTIME_FILE="$PROJECT_DIR/.lumina_runtime"
BACKEND_DIR="$PROJECT_DIR/backend"
FRONTEND_DIR="$PROJECT_DIR/frontend"
VENV_DIR="$BACKEND_DIR/venv"
BACKEND_PORT="8000"
FRONTEND_PORT="8600"
BACKEND_LOG="$PROJECT_DIR/backend.log"
FRONTEND_LOG="$PROJECT_DIR/frontend.log"
WORKER_LOG="$PROJECT_DIR/worker.log"

run_project_script() {
    local script_name="$1"
    local script_path="$PROJECT_DIR/$script_name"
    if [ ! -f "$script_path" ]; then
        echo -e "${RED}未找到脚本: $script_path${NC}"
        echo -e "${YELLOW}当前项目目录: $PROJECT_DIR${NC}"
        return 1
    fi
    cd "$PROJECT_DIR"
    exec bash "$script_path"
}

load_runtime() {
    if [ -f "$RUNTIME_FILE" ]; then
        # shellcheck disable=SC1090
        source "$RUNTIME_FILE"
    fi
    BACKEND_DIR="${BACKEND_DIR:-$PROJECT_DIR/backend}"
    FRONTEND_DIR="${FRONTEND_DIR:-$PROJECT_DIR/frontend}"
    VENV_DIR="${VENV_DIR:-$BACKEND_DIR/venv}"
    BACKEND_PORT="${BACKEND_PORT:-8000}"
    FRONTEND_PORT="${FRONTEND_PORT:-8600}"
    BACKEND_LOG="${BACKEND_LOG:-$PROJECT_DIR/backend.log}"
    FRONTEND_LOG="${FRONTEND_LOG:-$PROJECT_DIR/frontend.log}"
    WORKER_LOG="${WORKER_LOG:-$PROJECT_DIR/worker.log}"
}

find_backend_pids() {
    pgrep -f "$VENV_DIR/bin/uvicorn" 2>/dev/null || true
}

find_worker_pids() {
    pgrep -f "$BACKEND_DIR/worker.py" 2>/dev/null || true
}

find_backend_port_pids() {
    lsof -t -i:"$BACKEND_PORT" 2>/dev/null || true
}

find_frontend_pids() {
    local pids
    pids="$(lsof -t -i:"$FRONTEND_PORT" 2>/dev/null || true)"
    if [ -n "$pids" ]; then
        printf '%s\n' "$pids"
        return
    fi
    pgrep -f "$FRONTEND_DIR/server.cjs" 2>/dev/null || true
}

stop_backend() {
    if use_systemd_services; then
        systemctl stop "$SYSTEMD_BACKEND_SERVICE" 2>/dev/null || true
        return
    fi

    local pids backend_pids port_pids
    backend_pids="$(find_backend_pids)"
    port_pids="$(find_backend_port_pids)"
    pids="$(
        {
            [ -n "$backend_pids" ] && printf '%s\n' "$backend_pids"
            [ -n "$port_pids" ] && printf '%s\n' "$port_pids"
        } | awk 'NF' | sort -u
    )"
    if [ -z "$pids" ]; then
        echo "后端未运行"
        return
    fi
    echo "停止后端: $pids"
    kill $pids 2>/dev/null || true
    sleep 2
    pids="$(find_backend_pids)"
    if [ -n "$pids" ]; then
        kill -9 $pids 2>/dev/null || true
    fi
}

stop_worker() {
    if use_systemd_services; then
        systemctl stop "$SYSTEMD_WORKER_SERVICE" 2>/dev/null || true
        return
    fi

    local pids
    pids="$(find_worker_pids)"
    if [ -z "$pids" ]; then
        echo "生成 Worker 未运行"
        return
    fi
    echo "停止生成 Worker: $pids"
    kill $pids 2>/dev/null || true
    sleep 2
    pids="$(find_worker_pids)"
    if [ -n "$pids" ]; then
        kill -9 $pids 2>/dev/null || true
    fi
}

stop_frontend() {
    if use_systemd_services; then
        systemctl stop "$SYSTEMD_FRONTEND_SERVICE" 2>/dev/null || true
        return
    fi

    local pids
    pids="$(find_frontend_pids)"
    if [ -z "$pids" ]; then
        echo "前端未运行"
        return
    fi
    echo "停止前端: $pids"
    kill $pids 2>/dev/null || true
    sleep 2
    pids="$(find_frontend_pids)"
    if [ -n "$pids" ]; then
        kill -9 $pids 2>/dev/null || true
    fi
}

start_backend() {
    if use_systemd_services; then
        systemctl start "$SYSTEMD_BACKEND_SERVICE"
        sleep 1
        if systemctl is-active --quiet "$SYSTEMD_BACKEND_SERVICE"; then
            echo -e "${GREEN}后端已通过 systemd 启动${NC}"
            return 0
        fi
        echo -e "${RED}后端 systemd 启动失败，请检查: journalctl -u $SYSTEMD_BACKEND_SERVICE${NC}"
        return 1
    fi

    local backend_pids port_pids
    if [ ! -x "$VENV_DIR/bin/uvicorn" ]; then
        echo -e "${RED}未找到后端运行环境: $VENV_DIR/bin/uvicorn${NC}"
        return 1
    fi
    backend_pids="$(find_backend_pids)"
    if [ -n "$backend_pids" ]; then
        echo "后端已运行"
        return 0
    fi
    port_pids="$(find_backend_port_pids)"
    if [ -n "$port_pids" ]; then
        echo -e "${RED}后端端口 $BACKEND_PORT 已被其他进程占用 (PID: $port_pids)${NC}"
        return 1
    fi
    mkdir -p "$(dirname "$BACKEND_LOG")"
    export PYTHONUNBUFFERED=1
    nohup "$VENV_DIR/bin/uvicorn" main:app --app-dir "$BACKEND_DIR" --host 127.0.0.1 --port "$BACKEND_PORT" >> "$BACKEND_LOG" 2>&1 &
    sleep 2
    if [ -n "$(find_backend_pids)" ]; then
        echo -e "${GREEN}后端已启动: 127.0.0.1:$BACKEND_PORT${NC}"
        return 0
    fi
    echo -e "${RED}后端启动失败，请查看日志: $BACKEND_LOG${NC}"
    return 1
}

start_worker() {
    if use_systemd_services; then
        systemctl start "$SYSTEMD_WORKER_SERVICE"
        sleep 1
        if systemctl is-active --quiet "$SYSTEMD_WORKER_SERVICE"; then
            echo -e "${GREEN}生成 Worker 已通过 systemd 启动${NC}"
            return 0
        fi
        echo -e "${RED}生成 Worker 启动失败，请检查: journalctl -u $SYSTEMD_WORKER_SERVICE${NC}"
        return 1
    fi

    if [ ! -x "$VENV_DIR/bin/python" ] || [ ! -f "$BACKEND_DIR/worker.py" ]; then
        echo -e "${RED}未找到生成 Worker 运行文件或 Python 环境${NC}"
        return 1
    fi
    if [ -n "$(find_worker_pids)" ]; then
        echo "生成 Worker 已运行"
        return 0
    fi
    mkdir -p "$(dirname "$WORKER_LOG")"
    export PYTHONUNBUFFERED=1
    nohup "$VENV_DIR/bin/python" "$BACKEND_DIR/worker.py" >> "$WORKER_LOG" 2>&1 &
    sleep 2
    if [ -n "$(find_worker_pids)" ]; then
        echo -e "${GREEN}生成 Worker 已启动${NC}"
        return 0
    fi
    echo -e "${RED}生成 Worker 启动失败，请查看日志: $WORKER_LOG${NC}"
    return 1
}

start_frontend() {
    if use_systemd_services; then
        systemctl start "$SYSTEMD_FRONTEND_SERVICE"
        sleep 1
        if systemctl is-active --quiet "$SYSTEMD_FRONTEND_SERVICE"; then
            echo -e "${GREEN}前端已通过 systemd 启动${NC}"
            return 0
        fi
        echo -e "${RED}前端 systemd 启动失败，请检查: journalctl -u $SYSTEMD_FRONTEND_SERVICE${NC}"
        return 1
    fi

    if [ ! -f "$FRONTEND_DIR/server.cjs" ]; then
        echo -e "${RED}未找到前端服务文件: $FRONTEND_DIR/server.cjs${NC}"
        return 1
    fi
    if [ -n "$(find_frontend_pids)" ]; then
        echo "前端已运行"
        return 0
    fi
    if lsof -t -i:"$FRONTEND_PORT" >/dev/null 2>&1; then
        echo -e "${RED}前端端口 $FRONTEND_PORT 已被其他进程占用${NC}"
        return 1
    fi
    mkdir -p "$(dirname "$FRONTEND_LOG")"
    nohup node "$FRONTEND_DIR/server.cjs" >> "$FRONTEND_LOG" 2>&1 &
    sleep 2
    if [ -n "$(find_frontend_pids)" ]; then
        echo -e "${GREEN}前端已启动: 0.0.0.0:$FRONTEND_PORT${NC}"
        return 0
    fi
    echo -e "${RED}前端启动失败，请查看日志: $FRONTEND_LOG${NC}"
    return 1
}

show_status() {
    if use_systemd_services; then
        echo -e "${BLUE}项目目录:${NC} $PROJECT_DIR"
        echo -e "${BLUE}后端端口:${NC} $BACKEND_PORT"
        echo -e "${BLUE}前端端口:${NC} $FRONTEND_PORT"
        if systemctl is-active --quiet "$SYSTEMD_BACKEND_SERVICE"; then
            echo -e "${GREEN}后端运行中(systemd):${NC} $SYSTEMD_BACKEND_SERVICE"
        else
            echo -e "${YELLOW}后端未运行(systemd):${NC} $SYSTEMD_BACKEND_SERVICE"
        fi
        if systemctl is-active --quiet "$SYSTEMD_WORKER_SERVICE"; then
            echo -e "${GREEN}生成 Worker 运行中(systemd):${NC} $SYSTEMD_WORKER_SERVICE"
        else
            echo -e "${YELLOW}生成 Worker 未运行(systemd):${NC} $SYSTEMD_WORKER_SERVICE"
        fi
        if systemctl is-active --quiet "$SYSTEMD_FRONTEND_SERVICE"; then
            echo -e "${GREEN}前端运行中(systemd):${NC} $SYSTEMD_FRONTEND_SERVICE"
        else
            echo -e "${YELLOW}前端未运行(systemd):${NC} $SYSTEMD_FRONTEND_SERVICE"
        fi
        echo "后端日志: $BACKEND_LOG"
        echo "Worker 日志: $WORKER_LOG"
        echo "前端日志: $FRONTEND_LOG"
        return
    fi

    local backend_pids worker_pids frontend_pids
    backend_pids="$(find_backend_pids)"
    worker_pids="$(find_worker_pids)"
    frontend_pids="$(find_frontend_pids)"
    echo -e "${BLUE}项目目录:${NC} $PROJECT_DIR"
    echo -e "${BLUE}后端端口:${NC} $BACKEND_PORT"
    echo -e "${BLUE}前端端口:${NC} $FRONTEND_PORT"
    if [ -n "$backend_pids" ]; then
        echo -e "${GREEN}后端运行中${NC} PID: $backend_pids"
    else
        echo -e "${YELLOW}后端未运行${NC}"
    fi
    if [ -n "$worker_pids" ]; then
        echo -e "${GREEN}生成 Worker 运行中${NC} PID: $worker_pids"
    else
        echo -e "${YELLOW}生成 Worker 未运行${NC}"
    fi
    if [ -n "$frontend_pids" ]; then
        echo -e "${GREEN}前端运行中${NC} PID: $frontend_pids"
    else
        echo -e "${YELLOW}前端未运行${NC}"
    fi
    echo "后端日志: $BACKEND_LOG"
    echo "Worker 日志: $WORKER_LOG"
    echo "前端日志: $FRONTEND_LOG"
}

show_help() {
    cat <<'EOF'
妙笔流光运维命令

用法:
  miaobi                打开中文运维面板
  miaobi status         查看运行状态
  miaobi start          启动后端、生成 Worker 与前端服务
  miaobi stop           停止全部服务
  miaobi restart        重启全部服务
  miaobi logs backend   查看后端日志
  miaobi logs worker    查看生成 Worker 日志
  miaobi logs frontend  查看前端日志
  miaobi update         执行更新脚本
  miaobi uninstall      执行卸载脚本
  miaobi ports          查看当前端口
  miaobi help           查看帮助
EOF
}

show_menu() {
    while true; do
        echo
        echo -e "${BLUE}====== 妙笔流光运维面板 ======${NC}"
        echo "1) 查看状态"
        echo "2) 启动服务"
        echo "3) 停止服务"
        echo "4) 重启服务"
        echo "5) 查看后端日志"
        echo "6) 查看生成 Worker 日志"
        echo "7) 查看前端日志"
        echo "8) 执行更新"
        echo "9) 执行卸载"
        echo "10) 退出"
        read -r -p "请选择操作 [1-10]: " choice
        case "$choice" in
            1) show_status ;;
            2) start_backend && start_worker && start_frontend ;;
            3) stop_frontend; stop_worker; stop_backend ;;
            4) stop_frontend; stop_worker; stop_backend; start_backend && start_worker && start_frontend ;;
            5) exec tail -f "$BACKEND_LOG" ;;
            6) exec tail -f "$WORKER_LOG" ;;
            7) exec tail -f "$FRONTEND_LOG" ;;
            8) run_project_script "update.sh" ;;
            9) run_project_script "uninstall.sh" ;;
            10) exit 0 ;;
            *) echo -e "${YELLOW}无效选项，请重新输入${NC}" ;;
        esac
    done
}

main() {
    load_runtime
    local cmd="${1:-menu}"
    case "$cmd" in
        menu)
            show_menu
            ;;
        status)
            show_status
            ;;
        start)
            start_backend && start_worker && start_frontend
            ;;
        stop)
            stop_frontend
            stop_worker
            stop_backend
            ;;
        restart)
            stop_frontend
            stop_worker
            stop_backend
            start_backend && start_worker && start_frontend
            ;;
        logs)
            case "${2:-}" in
                backend) exec tail -f "$BACKEND_LOG" ;;
                worker) exec tail -f "$WORKER_LOG" ;;
                frontend) exec tail -f "$FRONTEND_LOG" ;;
                *)
                    echo -e "${RED}请指定 logs backend、logs worker 或 logs frontend${NC}"
                    exit 1
                    ;;
            esac
            ;;
        update)
            run_project_script "update.sh"
            ;;
        uninstall)
            run_project_script "uninstall.sh"
            ;;
        ports)
            echo "后端端口: $BACKEND_PORT"
            echo "前端端口: $FRONTEND_PORT"
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo -e "${RED}未知命令: $cmd${NC}"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
