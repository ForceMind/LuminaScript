#!/bin/bash

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
if [ -z "${SCRIPT_PATH:-}" ]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

is_project_dir() {
    local dir="$1"
    [ -n "$dir" ] || return 1
    [ -d "$dir" ] || return 1
    [ -d "$dir/backend" ] || return 1
    [ -d "$dir/frontend" ] || return 1
    [ -f "$dir/update.sh" ] || return 1
    [ -f "$dir/uninstall.sh" ] || return 1
    return 0
}

resolve_from_runtime_file() {
    local runtime_file="$1"
    local value=""
    [ -f "$runtime_file" ] || return 1
    value="$(sed -n 's/^PROJECT_DIR=//p' "$runtime_file" | head -n 1)"
    [ -n "$value" ] || return 1
    if is_project_dir "$value"; then
        cd "$value" && pwd
        return 0
    fi
    return 1
}

detect_project_dir() {
    local candidate resolved

    if [ -n "${MIAOBI_PROJECT_DIR:-}" ] && is_project_dir "$MIAOBI_PROJECT_DIR"; then
        cd "$MIAOBI_PROJECT_DIR" && pwd
        return
    fi

    for candidate in "$SCRIPT_DIR" "$PWD" "/root/LuminaScript" "/opt/LuminaScript" "/srv/LuminaScript"; do
        if is_project_dir "$candidate"; then
            cd "$candidate" && pwd
            return
        fi
    done

    for candidate in "$SCRIPT_DIR/.lumina_runtime" "$PWD/.lumina_runtime" "/root/LuminaScript/.lumina_runtime"; do
        if resolved="$(resolve_from_runtime_file "$candidate")"; then
            echo "$resolved"
            return
        fi
    done

    echo "$SCRIPT_DIR"
}

PROJECT_DIR="$(detect_project_dir)"
RUNTIME_FILE="$PROJECT_DIR/.lumina_runtime"
BACKEND_DIR="$PROJECT_DIR/backend"
FRONTEND_DIR="$PROJECT_DIR/frontend"
VENV_DIR="$BACKEND_DIR/venv"
BACKEND_PORT="8000"
FRONTEND_PORT="8600"
BACKEND_LOG="$PROJECT_DIR/backend.log"
FRONTEND_LOG="$PROJECT_DIR/frontend.log"

run_project_script() {
    local script_name="$1"
    local script_path="$PROJECT_DIR/$script_name"
    if [ ! -f "$script_path" ]; then
        echo -e "${RED}未找到脚本: $script_path${NC}"
        echo -e "${YELLOW}当前项目目录: $PROJECT_DIR${NC}"
        return 1
    fi
    exec bash "$script_path"
}

load_runtime() {
    if [ -f "$RUNTIME_FILE" ]; then
        # shellcheck disable=SC1090
        source "$RUNTIME_FILE"
    fi
    BACKEND_DIR="${BACKEND_DIR:-$PROJECT_DIR/backend}"
    FRONTEND_DIR="${FRONTEND_DIR:-$PROJECT_DIR/frontend}"
    VENV_DIR="${VENV_DIR:-$BACKEND_DIR/venv}"
    BACKEND_PORT="${BACKEND_PORT:-8000}"
    FRONTEND_PORT="${FRONTEND_PORT:-8600}"
    BACKEND_LOG="${BACKEND_LOG:-$PROJECT_DIR/backend.log}"
    FRONTEND_LOG="${FRONTEND_LOG:-$PROJECT_DIR/frontend.log}"
}

find_backend_pids() {
    pgrep -f "$PROJECT_DIR/backend/venv/bin/uvicorn" 2>/dev/null || true
}

find_frontend_pids() {
    local pids
    pids="$(lsof -t -i:"$FRONTEND_PORT" 2>/dev/null || true)"
    if [ -n "$pids" ]; then
        printf '%s\n' "$pids"
        return
    fi
    pgrep -f "$FRONTEND_DIR/server.cjs" 2>/dev/null || true
}

stop_backend() {
    local pids
    pids="$(find_backend_pids)"
    if [ -z "$pids" ]; then
        echo "后端未运行"
        return
    fi
    echo "停止后端: $pids"
    kill $pids 2>/dev/null || true
    sleep 2
    pids="$(find_backend_pids)"
    if [ -n "$pids" ]; then
        kill -9 $pids 2>/dev/null || true
    fi
}

stop_frontend() {
    local pids
    pids="$(find_frontend_pids)"
    if [ -z "$pids" ]; then
        echo "前端未运行"
        return
    fi
    echo "停止前端: $pids"
    kill $pids 2>/dev/null || true
    sleep 2
    pids="$(find_frontend_pids)"
    if [ -n "$pids" ]; then
        kill -9 $pids 2>/dev/null || true
    fi
}

start_backend() {
    if [ ! -x "$VENV_DIR/bin/uvicorn" ]; then
        echo -e "${RED}未找到后端运行环境: $VENV_DIR/bin/uvicorn${NC}"
        return 1
    fi
    if [ -n "$(find_backend_pids)" ]; then
        echo "后端已运行"
        return 0
    fi
    if lsof -t -i:"$BACKEND_PORT" >/dev/null 2>&1; then
        echo -e "${RED}后端端口 $BACKEND_PORT 已被其他进程占用${NC}"
        return 1
    fi
    mkdir -p "$(dirname "$BACKEND_LOG")"
    export PYTHONUNBUFFERED=1
    nohup "$VENV_DIR/bin/uvicorn" main:app --app-dir "$BACKEND_DIR" --host 0.0.0.0 --port "$BACKEND_PORT" >> "$BACKEND_LOG" 2>&1 &
    sleep 2
    if [ -n "$(find_backend_pids)" ]; then
        echo -e "${GREEN}后端已启动: 0.0.0.0:$BACKEND_PORT${NC}"
        return 0
    fi
    echo -e "${RED}后端启动失败，请查看日志: $BACKEND_LOG${NC}"
    return 1
}

start_frontend() {
    if [ ! -f "$FRONTEND_DIR/server.cjs" ]; then
        echo -e "${RED}未找到前端服务文件: $FRONTEND_DIR/server.cjs${NC}"
        return 1
    fi
    if [ -n "$(find_frontend_pids)" ]; then
        echo "前端已运行"
        return 0
    fi
    if lsof -t -i:"$FRONTEND_PORT" >/dev/null 2>&1; then
        echo -e "${RED}前端端口 $FRONTEND_PORT 已被其他进程占用${NC}"
        return 1
    fi
    mkdir -p "$(dirname "$FRONTEND_LOG")"
    nohup node "$FRONTEND_DIR/server.cjs" >> "$FRONTEND_LOG" 2>&1 &
    sleep 2
    if [ -n "$(find_frontend_pids)" ]; then
        echo -e "${GREEN}前端已启动: 0.0.0.0:$FRONTEND_PORT${NC}"
        return 0
    fi
    echo -e "${RED}前端启动失败，请查看日志: $FRONTEND_LOG${NC}"
    return 1
}

show_status() {
    local backend_pids frontend_pids
    backend_pids="$(find_backend_pids)"
    frontend_pids="$(find_frontend_pids)"
    echo -e "${BLUE}项目目录:${NC} $PROJECT_DIR"
    echo -e "${BLUE}后端端口:${NC} $BACKEND_PORT"
    echo -e "${BLUE}前端端口:${NC} $FRONTEND_PORT"
    if [ -n "$backend_pids" ]; then
        echo -e "${GREEN}后端运行中${NC} PID: $backend_pids"
    else
        echo -e "${YELLOW}后端未运行${NC}"
    fi
    if [ -n "$frontend_pids" ]; then
        echo -e "${GREEN}前端运行中${NC} PID: $frontend_pids"
    else
        echo -e "${YELLOW}前端未运行${NC}"
    fi
    echo "后端日志: $BACKEND_LOG"
    echo "前端日志: $FRONTEND_LOG"
}

show_help() {
    cat <<'EOF'
妙笔流光运维命令

用法:
  miaobi                打开中文运维面板
  miaobi status         查看运行状态
  miaobi start          启动前后端服务
  miaobi stop           停止前后端服务
  miaobi restart        重启前后端服务
  miaobi logs backend   查看后端日志
  miaobi logs frontend  查看前端日志
  miaobi update         执行更新脚本
  miaobi uninstall      执行卸载脚本
  miaobi ports          查看当前端口
  miaobi help           查看帮助
EOF
}

show_menu() {
    while true; do
        echo
        echo -e "${BLUE}====== 妙笔流光运维面板 ======${NC}"
        echo "1) 查看状态"
        echo "2) 启动服务"
        echo "3) 停止服务"
        echo "4) 重启服务"
        echo "5) 查看后端日志"
        echo "6) 查看前端日志"
        echo "7) 执行更新"
        echo "8) 执行卸载"
        echo "9) 退出"
        read -r -p "请选择操作 [1-9]: " choice
        case "$choice" in
            1) show_status ;;
            2) start_backend && start_frontend ;;
            3) stop_frontend; stop_backend ;;
            4) stop_frontend; stop_backend; start_backend && start_frontend ;;
            5) exec tail -f "$BACKEND_LOG" ;;
            6) exec tail -f "$FRONTEND_LOG" ;;
            7) run_project_script "update.sh" ;;
            8) run_project_script "uninstall.sh" ;;
            9) exit 0 ;;
            *) echo -e "${YELLOW}无效选项，请重新输入${NC}" ;;
        esac
    done
}

main() {
    load_runtime
    local cmd="${1:-menu}"
    case "$cmd" in
        menu)
            show_menu
            ;;
        status)
            show_status
            ;;
        start)
            start_backend && start_frontend
            ;;
        stop)
            stop_frontend
            stop_backend
            ;;
        restart)
            stop_frontend
            stop_backend
            start_backend && start_frontend
            ;;
        logs)
            case "${2:-}" in
                backend) exec tail -f "$BACKEND_LOG" ;;
                frontend) exec tail -f "$FRONTEND_LOG" ;;
                *)
                    echo -e "${RED}请指定 logs backend 或 logs frontend${NC}"
                    exit 1
                    ;;
            esac
            ;;
        update)
            run_project_script "update.sh"
            ;;
        uninstall)
            run_project_script "uninstall.sh"
            ;;
        ports)
            echo "后端端口: $BACKEND_PORT"
            echo "前端端口: $FRONTEND_PORT"
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo -e "${RED}未知命令: $cmd${NC}"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
